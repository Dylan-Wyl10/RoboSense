# Flow directories (generated by script, large route files).
# The per-MPR route + turn-ratio files ARE tracked: popularity_rerun.py and
# nweight_rerun.py read them via OD_SOURCES, so a fresh clone cannot reproduce
# the case study without them. The .od / .odtrips.xml intermediates stay out --
# they are regenerable with src/od_generator/.
sumo_cfg/5x5net/od/flow*/*
!sumo_cfg/5x5net/od/flow*/od.rou.xml
!sumo_cfg/5x5net/od/flow*/od_mixed.rou.xml
!sumo_cfg/5x5net/od/flow*/turnRatios.add.xml

# Scattered XML files (not tracked)
sumo_cfg/5x5net/edge_output.add.xml
sumo_cfg/5x5net/od_mixed.rou.xml
sumo_cfg/5x5net/od_file_bgv.odtrips.xml
sumo_cfg/5x5net/od_file_cav.odtrips.xml
sumo_cfg/5x5net/netgrid_topology.json
sumo_cfg/5x5net/od/od_mixed.rou.xml

# SUMO raw simulation output (regenerable, hundreds of MB -- see DATA.md).
# Aggregated `overall*.xml` and the flextable JSONs stay tracked; only the
# per-vehicle / per-step dumps are excluded.
result/**/summary*.xml
result/**/tripinfo*.xml
result/ctmResult/detector_out.xml
sumo_cfg/*/summary_benchmark.xml
sumo_cfg/*/tripinfo_benchmark.xml

# Gurobi infeasibility dumps
*.ilp

# Neural-routing spike (tracked on the exp/fm-mcvrp-local branch, not on main)
experiments/
neural_route/

# LaTeX working copies (managed outside this repo)
partb_latex_check_*/