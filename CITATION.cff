    given-names: Yilin
    email: wang4517@purdue.edu
    affiliation: "Lyles School of Civil and Construction Engineering, Purdue University"
  - family-names: Feng
    given-names: Yiheng
    email: feng333@purdue.edu
    affiliation: "Lyles School of Civil and Construction Engineering, Purdue University"

